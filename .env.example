# ===== Recordatorios consultorio — configuración =====
# Copia este archivo a `.env` y ajusta los valores. `.env` nunca se sube al repositorio.

# Modo de ejecución: demo (por defecto) o real
MODE=demo

# Ruta del archivo SQLite (la carpeta `data/` se crea al arrancar)
DATABASE_PATH=data/recordatorios.db

# Zona horaria del consultorio (nombre IANA; por definir con la doctora)
CLINIC_TIMEZONE=

# Ventana de envío en hora local del consultorio (horas 0-23)
SEND_WINDOW_START=8
SEND_WINDOW_END=20

# Lectura del calendario cada N minutos
SYNC_INTERVAL_MINUTES=5

# Intentos de envío antes de marcar Error de envío
MAX_SEND_ATTEMPTS=3

# Horas tras el recordatorio de 24 h para marcar «Sin confirmar»
UNCONFIRMED_AFTER_HOURS=3

# Acceso al panel (solo se usan en MODE=real)
PANEL_PASSWORD=
SESSION_SECRET=

# Google Calendar (solo MODE=real)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=

# WhatsApp Cloud API (solo MODE=real)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
